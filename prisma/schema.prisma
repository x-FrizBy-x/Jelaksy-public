generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserPlan {
  Basic
  Pro
  Ultra
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  name          String
  passwordHash  String
  plan          UserPlan  @default(Basic)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects      Project[]
  chatUsage     ChatUsage[]
}

model ChatUsage {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokens    Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Project {
  id          String        @id @default(cuid())
  ownerId     Int
  name        String
  description String
  roadmap     Json?
  chatMessages Json?
  // Bumped on every roadmap/chat write; writers compare it to avoid lost updates.
  version     Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}